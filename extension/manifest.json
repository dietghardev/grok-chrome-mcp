{
  "manifest_version": 3,
  "name": "Grok Chrome",
  "version": "0.2.0",
  "description": "Lets Grok Build drive this Chrome from the terminal.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grok Chrome"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "alarms",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
